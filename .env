# Nombre EXACTO del grupo origen (como aparece en WhatsApp)
WHATSAPP_GROUP_SOURCE=Asindaa 2

# Lista de grupos destino separados por coma, sin espacios al final
WHATSAPP_GROUP_TARGETS=Asindaa 2,Asindaa 3,Asindaa 4

# Texto del hashtag que activa la replicación
TRIGGER=#publicar

# Tiempos de espera (milisegundos)
SEND_DELAY_MS=1500
MAX_GROUPS_PER_BATCH=5
BATCH_PAUSE_MS=12000

# Reintentos en caso de error al enviar
RETRY_ATTEMPTS=2
RETRY_BACKOFF_MS=2500
JITTER_MS=500

# Pon 1 para listar los grupos al iniciar
LIST_GROUPS=1
