# NOMBRE EXACTO del grupo desde el que vas a publicar
WHATSAPP_GROUP_SOURCE=Asindae 2

# Grupos destino separados por coma, SIN espacios extra al final
WHATSAPP_GROUP_TARGETS=Asindae 3,Asindae 4,Asindae 5,Asindae 6,Asindae 7,Asindae 8,Asindae 9,Asindae 10,Asindae 11,Asindae 12,Asindae 13,Asindae 14,Asindae 15,Asindae 16,Asindae 17,Asindae 18,Asindae 19,Asindae 20,Asindae 21,Asindae 22,Asindae 23

# Gatillo en el caption del mensaje (debe incluir media)
TRIGGER=#publicar

# Timings (ms)
SEND_DELAY_MS=1500
MAX_GROUPS_PER_BATCH=5
BATCH_PAUSE_MS=12000

# Reintentos
RETRY_ATTEMPTS=2
RETRY_BACKOFF_MS=2500
JITTER_MS=500

# Pon 1 para listar todos los grupos al iniciar (te ayuda a copiar nombres exactos)
LIST_GROUPS=0

